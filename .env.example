# Flask Configuration
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# Admin credentials for the first operator account.
# If left unset, app.py will generate a random one-time password on first run.
ADMIN_USER=
ADMIN_PASS=

# Threat Intel (AbuseIPDB)
ABUSEIPDB_API_KEY=
MOCK_TI_MODE=true

# Comma-separated list of origins allowed to call the API/dashboard
# e.g. https://your-dashboard.example.com,https://your-mobile-app.example.com
ALLOWED_ORIGINS=

# Firewall Backend (options: netsh, iptables, none)
FIREWALL_BACKEND=none
